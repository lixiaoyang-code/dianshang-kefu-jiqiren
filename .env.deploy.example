# Copy this template to .env.deploy ON THE SERVER. Never commit .env.deploy.
# A real domain must resolve to the server. Do not include https:// or a path.
PUBLIC_DOMAIN=demo.example.com
APP_MODE=demo
ALLOWED_HOSTS=demo.example.com
ADMIN_USERNAME=owner
# Replace both values with independently generated random secrets.
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true

MODEL_MODE=auto
MODEL_PROVIDER=volcengine
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_NAME=doubao-seed-2-0-lite-260428
# Store the real API key only on the server. Empty = mock mode, no model calls.
ARK_API_KEY=
MODEL_TIMEOUT_SECONDS=12
INTENT_MODEL_ENABLED=true
INTENT_TIMEOUT_SECONDS=5
MODEL_THINKING=false

SEMANTIC_MODE=auto
DOWNLOAD_SEMANTIC_MODEL=true

# Accepted chat + RAG requests share a process-wide daily budget (UTC day).
# These are request limits, not token/currency limits. Restart resets the budget.
DEMO_REQUESTS_PER_MINUTE=60
DEMO_CHAT_PER_MINUTE=20
DEMO_DAILY_REQUESTS=500
DEMO_CONCURRENT_REQUESTS=3
DEMO_MAX_SESSIONS=200
DEMO_SESSIONS_PER_VISITOR=10
DEMO_SESSION_TTL_SECONDS=3600
